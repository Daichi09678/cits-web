# ========================================================
# CITS Indonesia - Environment Configuration for Vercel
# ========================================================

# 1. Database PostgreSQL Cloud (Neon / Supabase)
# Salin connection string dari Neon (https://neon.tech) atau Supabase (https://supabase.com):
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cits_db?sslmode=require

# 2. Notifikasi Email Resmi Formulir Kontak (SMTP)
# Masukkan akun email resmi (misal Gmail App Password, Google Workspace, atau cPanel Webmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@citsindonesia.co.id
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=info@citsindonesia.co.id

# 3. Retensi Kotak Masuk (Inbox)
# Pesan konsultasi yang lebih tua dari N hari dihapus otomatis dari database.
# Pembersihan berjalan saat inbox dibuka admin (maks. 1x per jam) dan lewat
# endpoint /api/messages/cleanup (bisa dipanggil cron).
MESSAGE_RETENTION_DAYS=30
# Nilai yang dipakai teks di halaman admin (opsional, samakan dengan di atas):
NEXT_PUBLIC_MESSAGE_RETENTION_DAYS=30

# 4. Proteksi endpoint cron pembersihan (opsional, sangat disarankan di produksi)
# Jika diisi, pemanggil wajib mengirim header: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=random-string-panjang
